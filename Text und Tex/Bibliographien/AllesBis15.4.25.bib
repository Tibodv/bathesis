	keywords = {applicant reactions, e-recruiting, employee recruitment, job applicants, online data, online technologies, organizations},
	file = {Snapshot:/home/tibo/Documents/Bachelorarbeit/Papers/Zotero/storage/UXE2NLZN/9781119256151.html:text/html},
