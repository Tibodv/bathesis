	keywords = {{AI}-enabled recruiting, Artificial intelligence, Digital recruiting technology, Human resources, zitiert},
	file = {ScienceDirect Snapshot:/home/tibo/Documents/Bachelorarbeit/Papers/Zotero/storage/9VZE24RS/S0007681319301612.html:text/html},
