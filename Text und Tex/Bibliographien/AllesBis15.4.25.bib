@article{charlwood_can_2022,
	title = {Can {HR} adapt to the paradoxes of artificial intelligence?},
	volume = {32},
	rights = {© 2022 The Authors. Human Resource Management Journal published by John Wiley \& Sons Ltd.},
	issn = {1748-8583},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/1748-8583.12433},
	doi = {10.1111/1748-8583.12433},
	abstract = {Artificial intelligence ({AI}) is widely heralded as a new and revolutionary technology that will transform the world of work. While the impact of {AI} on human resource ({HR}) and people management is difficult to predict, the article considers potential scenarios for how {AI} will affect our field. We argue that although popular accounts of {AI} stress the risks of bias and unfairness, these problems are eminently solvable. However, the way that the {AI} industry is currently constituted and wider trends in the use of technology for organising work mean that there is a significant risk that {AI} use will degrade the quality of work. Viewing different scenarios through a paradox lens, we argue that both positive and negative visions of the future are likely to coexist. The {HR} profession has a degree of agency to shape the future if it chooses to use it; {HR} professionals need to develop the skills to ensure that ethics and fairness are at the centre of {AI} development for {HR} and people management.},
	pages = {729--742},
	number = {4},
	journaltitle = {Human Resource Management Journal},
	author = {Charlwood, Andy and Guenole, Nigel},
	urldate = {2025-01-23},
	date = {2022},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/1748-8583.12433},
	keywords = {artificial intelligence, human resource management},
	file = {Full Text PDF:/home/tibo/Documents/Bachelorarbeit/Papers/Zotero/storage/S7ZMVZCF/Charlwood and Guenole - 2022 - Can HR adapt to the paradoxes of artificial intelligence.pdf:application/pdf;Snapshot:/home/tibo/Documents/Bachelorarbeit/Papers/Zotero/storage/56DZCBEX/1748-8583.html:text/html},
}

@inproceedings{xiao_who_2019,
	location = {New York, {NY}, {USA}},
	title = {Who should be my teammates: using a conversational agent to understand individuals and help teaming},
	isbn = {978-1-4503-6272-6},
	url = {https://dl.acm.org/doi/10.1145/3301275.3302264},
	doi = {10.1145/3301275.3302264},
	series = {{IUI} '19},
	shorttitle = {Who should be my teammates},
	abstract = {We are building an intelligent agent to help teaming efforts. In this paper, we investigate the real-world use of such an agent to understand students deeply and help student team formation in a large university class involving about 200 students and 40 teams. Specifically, the agent interacted with each student in a text-based conversation at the beginning and end of the class. We show how the intelligent agent was able to elicit in-depth information from the students, infer the students' personality traits, and reveal the complex relationships between team personality compositions and team results. We also report on the students' behavior with and impression of the agent. We discuss the benefits and limitations of such an intelligent agent in helping team formation, and the design considerations for creating intelligent agents for aiding in teaming efforts.},
	pages = {437--447},
	booktitle = {Proceedings of the 24th International Conference on Intelligent User Interfaces},
	publisher = {Association for Computing Machinery},
	author = {Xiao, Ziang and Zhou, Michelle X. and Fu, Wat-Tat},
	urldate = {2025-01-23},
	date = {2019-03-17},
	file = {Full Text PDF:/home/tibo/Documents/Bachelorarbeit/Papers/Zotero/storage/HRU52FTI/Xiao et al. - 2019 - Who should be my teammates using a conversational agent to understand individuals and help teaming.pdf:application/pdf},
}

