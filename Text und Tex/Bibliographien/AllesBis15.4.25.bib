	langid = {english},
	note = {Number: 2
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {{UTAUT}2, artificial intelligence adoption, behavioral intention, {ChatGPT}, generation Z, generative {AI}, human-{AI} interaction, technology acceptance model},
	file = {Full Text PDF:/home/tibo/Documents/Bachelorarbeit/Papers/Zotero/storage/ARG75RDR/Biloš und Budimir - 2024 - Understanding the Adoption Dynamics of ChatGPT among Generation Z Insights from a Modified UTAUT2 M.pdf:application/pdf},
