	file = {Full Text PDF:/home/tibo/Documents/Bachelorarbeit/Papers/Zotero/storage/RH834ASH/Nawaz and Gomes - 2020 - Artificial Intelligence Chatbots are New Recruiters.pdf:application/pdf},
